<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="550dp"
    android:layout_height="match_parent"
    android:background="@drawable/radius">

    <!-- 타이틀 -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:gravity="center"
        android:lineSpacingExtra="5dp"
        android:paddingTop="5dp"
        android:fontFamily="@font/sebang_gothic"
        android:background="@drawable/notice_gradient_background"
        android:text="설문 유형을 선택해주세요"
        android:textColor="@color/white"
        android:textSize="20dp"
        android:textStyle="bold"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintHeight_percent="0.08"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/close_btn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="1dp"
        android:background="@drawable/close_btn"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintWidth_percent="0.05"
        app:layout_constraintHorizontal_bias="0.98"
        app:layout_constraintTop_toTopOf="@+id/titleText"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="@+id/titleText"
        app:layout_constraintBottom_toBottomOf="@+id/titleText" />

    <!-- 카테고리 버튼 그룹 (그리드 구조) -->
    <GridLayout
        android:id="@+id/categoryGrid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="true"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_general"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:background="@drawable/tutor_dialog_title_custom"
            android:padding="10dp"
            android:layout_margin="8dp"
            android:text="일반"
            android:textSize="18sp"
            android:textColor="#af6400" />

        <Button
            android:id="@+id/btn_multicultural"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:background="@drawable/tutor_dialog_title_custom"
            android:padding="10dp"
            android:layout_margin="8dp"
            android:text="사회적 배려자\n(다문화)"
            android:textSize="18sp"
            android:textColor="#af6400" />

        <Button
            android:id="@+id/btn_remote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_marginTop="12dp"
            android:background="@drawable/tutor_dialog_title_custom"
            android:padding="10dp"
            android:layout_margin="8dp"
            android:text="사회적 배려자\n(도서벽지)"
            android:textSize="18sp"
            android:textColor="#af6400" />

        <Button
            android:id="@+id/btn_special"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_marginTop="12dp"
            android:background="@drawable/tutor_dialog_title_custom"
            android:padding="10dp"
            android:layout_margin="8dp"
            android:text="사회적 배려자\n(특수교육)"
            android:textSize="18sp"
            android:textColor="#af6400" />
    </GridLayout>

    <!-- 설문 리스트 그룹 -->
    <LinearLayout
        android:id="@+id/surveyListGroup"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@id/categoryGrid"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- "이전" 버튼 -->
        <TextView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← 돌아가기"
            android:textColor="#af6400"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_gravity="start"
            android:layout_marginLeft="10dp" />

        <!-- 선택된 카테고리 이름 표시 -->
        <TextView
            android:id="@+id/surveyCategoryTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="5dp"
            android:fontFamily="@font/sebang_gothic"
            android:text="카테고리 제목"
            android:textAlignment="center"
            android:textColor="#333333"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="15dp" />

        <!-- 설문 버튼이 동적으로 추가될 GridLayout -->
        <GridLayout
            android:id="@+id/surveyGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="true"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>